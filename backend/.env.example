# Copiá este archivo a backend/.env y reemplazá los valores. NUNCA subas el .env real al repositorio.
# En producción estas variables se definen en el panel de Render (ver docs/despliegue.md).

# URL de MySQL. Local: mysql://usuario:password@localhost:3306/danzas_app
# Aiven: pegá la Service URI de la consola y agregá connection_limit=5 (ver docs/despliegue.md, sección TLS).
DATABASE_URL="mysql://usuario:password@localhost:3306/danzas_app"

# Puerto local. En Render lo inyecta la plataforma: no lo definas allá.
PORT=3000

# Secreto para firmar los JWT. En producción usá un valor largo y aleatorio (Render puede generarlo).
JWT_SECRET="reemplazar-por-un-secreto-fuerte-en-produccion"

# Vigencia de la sesión (formato de jsonwebtoken: 30m, 1h, 7d...).
JWT_EXPIRES_IN="1h"

# "production" en Render. En ese modo se ignora simularRechazo del pago simulado.
NODE_ENV=development

# URL pública del frontend, sin "/" final. Se usa en el enlace del correo de recuperación de contraseña.
FRONTEND_URL="http://localhost:5173"

# Envío de correos con Resend. Si falta alguna de las dos, el backend solo registra "[correo simulado]" en consola.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="Danzas.app <no-reply@tu-dominio.com>"

# Solo para los scripts npm run create:admin / db:check (no las lee la API):
# ADMIN_EMAIL="admin@ejemplo.com"
# ADMIN_PASSWORD="reemplazar-con-una-clave-de-10-o-mas-caracteres"
# ADMIN_NOMBRE="Administrador"
