# Copiá este archivo a frontend/.env. NUNCA subas el .env real al repositorio.

# URL base de la API, INCLUYENDO el prefijo /api.
# Local: http://localhost:3000/api
# Producción (variable en Vercel): https://<tu-servicio>.onrender.com/api
# Vite la incrusta al compilar: si cambia, hay que volver a desplegar el frontend.
VITE_API_URL=http://localhost:3000/api
